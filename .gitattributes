# Force LF line endings for all source files (prevents CRLF issues on Windows)
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.svg  text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.whl  binary
*.pyc  binary
